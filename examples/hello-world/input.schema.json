{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hello_world round input",
  "description": "One round is a batch of tasks. Each task gives the submission a list of numbers to sort; the score is the fraction of tasks sorted correctly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_name", "numbers"],
        "properties": {
          "task_name": { "type": "string" },
          "numbers": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 1
          }
        }
      }
    }
  }
}
